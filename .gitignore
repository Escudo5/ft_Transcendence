__pycache__/
*.py[cod]
*.sqlite3

backend/.venv/
backend/.pytest_cache/
backend/.mypy_cache/

node_modules/
frontend/node_modules/
frontend/dist/
npm-debug.log*
yarn-error.log*

# El lock lo genera cada maquina: el de un Mac con chip Apple (arm64) y el de
# un ordenador Intel (x64) no son compatibles y rompen el arranque del front
package-lock.json

# Certificados que genera runserver_plus al arrancar en HTTPS.
# NUNCA deben subirse al repo (cert.key es una clave privada)
*.crt
*.key
*.pem

.env
backend/.env
frontend/.env
# Cualquier copia del .env: .env.backup, .env.viejo, .env.local...
# Llevan las credenciales de 42 dentro y NO pueden acabar en GitHub.
.env.*
!.env.example

# Fotos de perfil que sube la gente. Son datos de usuarios, no codigo: cada
# uno tiene las suyas en su ordenador y no tienen por que viajar en el repo.
backend/media/

.vscode/
.idea/
.DS_Store

mierdas_de_pablo/
