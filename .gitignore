__pycache__/
*.py[cod]
*.sqlite3

backend/.venv/
backend/.pytest_cache/
backend/.mypy_cache/

node_modules/
frontend/node_modules/
frontend/dist/
npm-debug.log*
yarn-error.log*

# El lock lo genera cada maquina: el de un Mac con chip Apple (arm64) y el de
# un ordenador Intel (x64) no son compatibles y rompen el arranque del front
package-lock.json

# Certificados que genera runserver_plus al arrancar en HTTPS.
# NUNCA deben subirse al repo (cert.key es una clave privada)
*.crt
*.key
*.pem

.env
backend/.env
frontend/.env
# Cualquier copia del .env: .env.backup, .env.viejo, .env.local...
# Llevan las credenciales de 42 dentro y NO pueden acabar en GitHub.
.env.*
!.env.example

# Fotos de perfil que sube la gente. Son datos de usuarios, no codigo: cada
# uno tiene las suyas en su ordenador y no tienen por que viajar en el repo.
backend/media/

# ⚠️ LA LISTA DE QUIEN HA PEDIDO NO APARECER. NUNCA AL REPO.
#
# La escribe borrar_mi_cuenta (users/views.py) al darse alguien de baja, y la
# leen fill_db y login_card para no volver a crearle la carta. Cae en
# backend/, que esta dentro del repo, asi que sin esta linea acabaria
# commiteada.
#
# Y seria justo lo contrario de lo que promete el borrado: publicar en un
# repositorio, para siempre, el nombre de quien pidio desaparecer. Va sin
# carpeta delante para que quede fuera este donde este.
ignore_logins.txt

.vscode/
.idea/
.DS_Store

# Basura que genera Windows al descargar un fichero y pasarlo a WSL.
# No son ficheros de verdad, son una marca interna: fuera del repo.
*:Zone.Identifier

mierdas_de_pablo/
