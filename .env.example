# =============================================================================
#  ft_transcendence - PLANTILLA de variables de entorno
#
#  Este fichero SI va en git y NO lleva ninguna clave de verdad.
#  El de verdad se llama .env, esta fuera del repositorio y nunca se sube.
#
#  QUE HACER LA PRIMERA VEZ:
#     cp .env.example .env
#     (rellena abajo las cuatro lineas marcadas con RELLENAR)
#     docker compose up -d --build
#
#  ⚠️ Docker lee este fichero SOLO al crear los contenedores. Si cambias algo
#     aqui con el proyecto encendido, no pasa nada hasta que los recrees:
#         docker compose down && docker compose up -d --build
#     Un 'restart' NO vale. Esto ya ha costado una tarde entera al equipo.
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# En local valen tal cual. En un servidor de verdad habria que cambiar la
# contrasena por una que no se pueda adivinar.
POSTGRES_DB=transcendence
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=transcendence
# POSTGRES_HOST y POSTGRES_PORT no van aqui a proposito: los pone el
# docker-compose.yml (host 'db', puerto 5432), porque son la direccion del
# contenedor de la base de datos y no dependen de quien levante el proyecto.

# --- Django ------------------------------------------------------------------
# La clave con la que Django firma las cookies de sesion. Para trabajar en
# local sirve cualquiera; en produccion tiene que ser larga y secreta.
DJANGO_SECRET_KEY=pon-aqui-una-clave-cualquiera-para-desarrollo
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Desde que direcciones puede llamar el navegador al backend. Van en https
# porque el proyecto se sirve cifrado.
CORS_ALLOWED_ORIGINS=https://localhost:3000,https://127.0.0.1:3000
# Direcciones de las que Django se fia al RECIBIR datos (formularios, POST).
# Si falta esta linea, Django usa una lista por defecto en http y fallan los
# envios con un 403 que no explica nada.
CSRF_TRUSTED_ORIGINS=https://localhost:3000,https://127.0.0.1:3000

# --- Frontend ----------------------------------------------------------------
# /api a secas, no una direccion completa: Vite reenvia esas llamadas al
# backend por dentro de Docker. Asi el navegador solo habla con el puerto 3000,
# basta con aceptar un certificado y desaparecen los problemas entre puertos.
VITE_API_URL=/api

# --- API de la Intra de 42 ---------------------------------------------------
URL_TOKEN=https://api.intra.42.fr/oauth/token
URL_PERFIL=https://api.intra.42.fr/v2/me
BASE_API=https://api.intra.42.fr/v2

# Direccion a la que 42 devuelve al alumno despues de identificarse. Tiene que
# coincidir LETRA POR LETRA con la que este registrada en la aplicacion de la
# Intra. SIN barra al final: una barra de mas tumba el login entero y 42 no
# dice por que.
#
# ⚠️ Y TIENE QUE COINCIDIR TAMBIEN CON LA DIRECCION QUE ABRES EN EL NAVEGADOR.
#    El front manda como redirect_uri lo que haya en la barra de direcciones
#    (window.location.origin, en App.jsx). Si aqui pones localhost y entras por
#    otro nombre, 42 contesta "redirect uri is not valid" y no explica mas.
FORTYTWO_REDIRECT_URI=https://localhost:3000

# -----------------------------------------------------------------------------
# 🌐 SI SOIS VARIOS EN MAQUINAS DISTINTAS (es como se enseña en la evaluacion)
#
# Con los valores de arriba solo funciona en la maquina que levanta el
# proyecto, abriendo https://localhost:3000. Para que entren varios hace falta
# un nombre comun, porque todos tienen que mandarle a 42 exactamente el mismo
# redirect_uri. Nosotros usamos transcendence.42.fr.
#
# Son CUATRO cosas y las cuatro tienen que decir lo mismo, o el login falla:
#
#   1. /etc/hosts de CADA maquina (ojo, con la s final):
#        - la que levanta el proyecto:   127.0.0.1   transcendence.42.fr
#        - las demas:                    <IP de esa maquina>   transcendence.42.fr
#      Se comprueba con  ping -c1 transcendence.42.fr , no mirando el fichero.
#
#   2. Este fichero: cambiar las cuatro variables de abajo por el nombre.
#
#   3. La aplicacion de la Intra: añadir https://transcendence.42.fr:3000
#      como redirect URI (admite varias, una por linea).
#
#   4. Recrear los contenedores:  docker compose up -d --force-recreate
#      Con `restart` NO basta: Docker lee el .env al CREAR el contenedor.
#
# Quedaria asi:
#   DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,transcendence.42.fr
#   CORS_ALLOWED_ORIGINS=https://localhost:3000,https://transcendence.42.fr:3000
#   CSRF_TRUSTED_ORIGINS=https://localhost:3000,https://transcendence.42.fr:3000
#   FORTYTWO_REDIRECT_URI=https://transcendence.42.fr:3000
#
# ⚠️ Y ENTONCES TODOS ENTRAN POR EL NOMBRE, TAMBIEN QUIEN LEVANTA EL PROYECTO.
#    Si el anfitrion entra por localhost mandara localhost y le fallara a el.
#    Precio de hacerlo asi: mientras el redirect apunte al nombre, localhost
#    deja de servir para el login de 42 (con correo y contraseña si sigue).
#
# 💡 Cambiar de maquina anfitriona es solo mover una almohadilla en el
#    /etc/hosts de los cuatro: ni codigo, ni este fichero, ni la Intra.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# 🔑 CLAVES DE LA INTRA — RELLENAR
#
# Se sacan de:  profile.intra.42.fr -> Settings -> API -> tu aplicacion
#   - el UID    es el CLIENT_ID     (no cambia nunca)
#   - el SECRET es el CLIENT_SECRET (CADUCA cada pocas semanas)
#
# Si el login empieza a fallar de golpe con 'invalid_client', casi siempre es
# que el secreto ha caducado: se renueva ahi mismo y se pega aqui.
#
# 🚨 Estas cuatro lineas NO se pegan nunca en el grupo de WhatsApp ni en
#    GitHub. Se pasan por privado y a quien las necesite.
# -----------------------------------------------------------------------------

# Aplicacion que usa el LOGIN de la web. La necesita todo el equipo.
CLIENT_ID_NACHO=RELLENAR-uid-de-la-aplicacion
CLIENT_SECRET_NACHO=RELLENAR-secret-de-la-aplicacion

# Aplicacion que usan los scripts que rellenan el catalogo de cartas
# (fill_db y login_card). El login de la web no la toca.
CLIENT_ID_PABLO=RELLENAR-uid-de-la-aplicacion
CLIENT_SECRET_PABLO=RELLENAR-secret-de-la-aplicacion

# -----------------------------------------------------------------------------
# 📧 CORREO — RELLENAR (anadido el 22/09, para los avisos del RGPD)
#
# Con esto la web manda dos correos: una copia de tus datos cuando los
# descargas, y un aviso cuando borras la cuenta. Ver users/views.py.
#
# Es una cuenta de Gmail del equipo con una CONTRASENA DE APLICACION, no la
# contrasena normal de la cuenta. Se saca en:
#     Cuenta de Google -> Seguridad -> Verificacion en dos pasos
#     -> Contrasenas de aplicacion
#
# ⚠️ SIN COMILLAS. Si pones EMAIL_HOST_PASSWORD='abcd...', Django intenta
#    entrar con las comillas incluidas y el envio falla con un error de
#    autenticacion que no dice de que va.
#
# ⚠️ Y SIN ESPACIOS: Google la ensena en grupos de cuatro (abcd efgh ijkl
#    mnop) pero se pega toda seguida.
#
# 🚨 Igual que las de la Intra: por privado, nunca en el grupo ni en GitHub.
#
# Si se dejan vacias, la web sigue funcionando: los correos simplemente no
# se mandan y ni la descarga de datos ni el borrado de cuenta se rompen.
# -----------------------------------------------------------------------------
EMAIL_HOST_USER=RELLENAR-correo-del-equipo@gmail.com
EMAIL_HOST_PASSWORD=RELLENAR-contrasena-de-aplicacion
